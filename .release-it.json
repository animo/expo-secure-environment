{
  "github": {
    "release": true
  },
  "npm": {
    "skipChecks": true,
    "ignoreVersion": true,
    "tag": "latest",
    "publishPackageManager": "pnpm",
    "publishArgs": ["--no-git-checks", "--provenance"]
  },
  "git": {
    "push": false,
    "commit": false,
    "requireCommits": true,
    "tagAnnotation": "${version}",
    "requireBranch": "main"
  }
}
